{
  "name": "qdown-youtube-downloader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "node server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "bundle:server": "npx esbuild server.js --format=cjs --outfile=dist-server/server.cjs",
    "build:exe": "npm run build && npm run bundle:server && npx pkg .",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.378.0",
    "open": "^10.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "youtube-dl-exec": "^3.0.1"
  },
  "pkg": {
    "scripts": "dist-server/**/*.js",
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
